# Copia este fichero como .env.local y rellena los valores.
# Son los del Supabase DEL CRM (CertiVertian comparte su base de datos):
# Supabase → Project Settings → API (o «API Keys»).
#
# La clave pública («anon» o «publishable») está pensada para ir en el
# navegador. NUNCA pongas aquí la clave «service_role» / «secret».
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_CLAVE_PUBLICA=
# (Opcional) Dirección del CRM, para el botón «Abrir en el CRM».
VITE_CRM_URL=
